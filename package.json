{
  "name": "astro-localized-routes",
  "version": "0.1.0",
  "description": "Translated slugs for Astro: one route tree drives localized URLs, hreflang, sitemap alternates, head metadata, JSON-LD and breadcrumbs.",
  "keywords": [
    "astro",
    "i18n",
    "routing",
    "localized-slugs",
    "hreflang",
    "sitemap",
    "seo"
  ],
  "license": "MIT",
  "author": "Federico Iglesias",
  "homepage": "https://github.com/fedeiglesias/astro-localized-routes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fedeiglesias/astro-localized-routes.git"
  },
  "bugs": {
    "url": "https://github.com/fedeiglesias/astro-localized-routes/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && pnpm run build && pnpm --filter example-basic --fail-if-no-match run check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "check:pack": "publint && node scripts/check-pack.mjs"
  },
  "peerDependencies": {
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "22.20.5",
    "node-html-parser": "9.0.5",
    "publint": "0.3.25",
    "tsdown": "0.23.2",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  }
}
